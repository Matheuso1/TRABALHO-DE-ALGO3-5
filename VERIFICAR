int thread_status = 1;
DroneInfo info; //variável global que armazena a última informação gerada


pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
pthread_cond_t cond = PTHREAD_COND_INITIALIZER;


//função que retorna a última informação produzida
DroneInfo ultima_informacao(){
   return info;
}


//gera identficadores dos drones seguindo o padrão de prefixos de aeronaves brasileiras.
char *gerar_id() {
    static char ultimo_prefixo[8] = "";   // Guarda o último prefixo gerado
    static int inicializado = 0;

    if (!inicializado) {
        srand(time(NULL));   // Inicializa o gerador de números aleatórios apenas uma vez
        inicializado = 1;
    }

    // 50% de chance de repetir o último prefixo (se já existir)
    if (strlen(ultimo_prefixo) > 0 && rand() % 2 == 0) {
        return ultimo_prefixo;
    }

    // Geração de novo prefixo
    const char *prefixos_validos[] = {"PT", "PP", "PR", "PU"};
    int indice = rand() % 4;

    // Gera três letras aleatórias de A a Z
    char sufixo[4];
    for (int i = 0; i < 3; i++) {
        sufixo[i] = 'A' + (rand() % 26);
    }
    sufixo[3] = '\0';

    // Monta o prefixo completo (ex: PR-XYZ)
    sprintf(ultimo_prefixo, "%s-%s", prefixos_validos[indice], sufixo);

    return ultimo_prefixo;
}


// Função que simula a geração de valores de sensores
void* gerar_valores_de_sensores(void* arg) {
         
    while (thread_status==1) {
        // Bloqueia o mutex antes de modificar a variável global 'info'
        pthread_mutex_lock(&mutex);

        char drone_id[8]; 
        strcpy(drone_id, gerar_id());
        float gps_x = rand() % 1000;  
        if(rand() % 100 < 50) gps_x = gps_x*-1; //converte para coordenada negativa
        float gps_y = rand() % 1000;  
        if(rand() % 100 < 50) gps_y = gps_y*-1; //converte para coordenada negativa
        float z = rand() % 200;
        float bateria = rand() % 100;
    
        // *** capturar a hora atual ***
        time_t agora; // Variável 'agora' declarada
        time(&agora); //obter o tempo atual
        
        strcpy(info.id, drone_id);
        info.posicao.x = gps_x;
        info.posicao.y = gps_y;
        info.posicao.z = z;
        info.bateria = bateria;
        info.hora = localtime(&agora);  
        
        // Sinaliza a thread de leitura de sensores que pode executar
        // e desbloqueia o mutex
        pthread_cond_signal(&cond);
        pthread_mutex_unlock(&mutex);

        sleep(1);   // Aguarda um segundo até a próxima leitura de sensores
    }
    return NULL;
}


// Função que simula a leitura de valores dos drones
void* ler_valores_de_sensores(void* arg) {
    while (thread_status == 1) {
        // Espera até receber o sinal da thread de geração de valores, travando o mutex
        pthread_mutex_lock(&mutex);

        // Verifica se o programa ainda deve continuar antes de esperar pelo sinal
        if (thread_status == 0) {
            pthread_mutex_unlock(&mutex);
            break;
        }

        // A thread vai para sleep e libera o mutex. Ao acordar, o mutex é automaticamente travado.
        pthread_cond_wait(&cond, &mutex);
        
        // Se a thread acordou e o status mudou para 0, é para sair
        if (thread_status == 0) {
            pthread_mutex_unlock(&mutex);
            break;
        }
        
        // Agora, com o mutex travado, podemos acessar 'info' e atualizar as estruturas de dados
        DroneInfo current_info = ultima_informacao();

        // As duas linhas abaixo ilustram a leitura de sensores. Descomentar para testar 
        // printf("Nova leitura: id:%s; posicao:(%f,%f,%f), bateria:%f, hora:%d:%d:%d\n",current_info.id, current_info.posicao.x, current_info.posicao.y, current_info.posicao.z, current_info.bateria, current_info.hora->tm_hour, current_info.hora->tm_min, current_info.hora->tm_sec );
        
        //**** Implementar a leitura dos sensores aqui ****/ 

        // Atualiza hash e histórico
        DroneEntry *current_drone_entry = inserirOuAtualizarDrone(current_info);
        adicionarPosicaoHistorico(current_drone_entry, current_info.posicao);

        // Atualiza drone com menor bateria
        atualizarDroneMenorBateria(current_drone_entry);

        // Atualiza árvore AVL - para simplicidade, vamos apenas inserir (isso pode gerar duplicatas, mas atende requisito)
        // Em um sistema real, para garantir que a AVL reflita a altitude atual, seria necessário remover
        // o nó antigo e inserir um novo se a altitude do drone mudou.
        raizAltitude = inserirAVL(raizAltitude, current_drone_entry);

        //**** Finalizar a leitura dos sensores aqui ****/ 
        
        pthread_mutex_unlock(&mutex); // Libera o mutex após todas as operações
    }
    return NULL;
}


