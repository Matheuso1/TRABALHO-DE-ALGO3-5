// Lista para histórico de posições (lista ligada)
typedef struct posicaoNode {
    Posicao pos;
    struct posicaoNode *prox;
} PosicaoNode;

// Entrada da tabela hash
typedef struct droneEntry {
    DroneInfo drone;
    PosicaoNode *historico;   // lista ligada com posições (mais recentes no início)
} DroneEntry;

// Tabela hash como array de ponteiros (usando sondagem linear para resolver colisão)
#define HASH_SIZE 10007 // Tamanho primo para reduzir colisão

// Variáveis globais para as estruturas de dados
DroneEntry *tabelaHash[HASH_SIZE]; // inicializa com NULLs
DroneEntry *droneMenorBateria = NULL; // ponteiro global para drone com menor bateria

// Funções da Tabela Hash
unsigned int hash(const char *id);
DroneEntry *buscarDrone(const char *id);
DroneEntry *inserirOuAtualizarDrone(DroneInfo novo);
void adicionarPosicaoHistorico(DroneEntry *entry, Posicao pos);
void atualizarDroneMenorBateria(DroneEntry *entry);

// --- AVL para drone por altitude ---
typedef struct nodeAltitude {
    DroneEntry *droneEntry; // Ponteiro para o DroneEntry na tabela hash
    struct nodeAltitude *left;
    struct nodeAltitude *right;
    int altura;
} NodeAltitude;

// Raiz global da AVL
NodeAltitude *raizAltitude = NULL; 

// Funções da Árvore AVL
int altura(NodeAltitude *n);
int max(int a, int b);
NodeAltitude *rotacaoDireita(NodeAltitude *y);
NodeAltitude *rotacaoEsquerda(NodeAltitude *x);
int balanceamento(NodeAltitude *n);
NodeAltitude *inserirAVL(NodeAltitude *raiz, DroneEntry *entry);
DroneEntry *buscarDronePorFaixaAVL(NodeAltitude *raiz, float minZ, float maxZ);

// Funções de Relatórios
void imprimirRotaRetorno(DroneEntry *entry, int x);

