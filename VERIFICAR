// Função hash simples
unsigned int hash(const char *id) {
    unsigned int h = 0;
    while (*id) {
        h = (h * 31 + (unsigned char)(*id++)) % HASH_SIZE; // Multiplicação e módulo para boa dispersão
    }
    return h;
}

// Busca drone na tabela hash pelo id (O(1) esperado, O(N) pior caso)
DroneEntry *buscarDrone(const char *id) {
    unsigned int h = hash(id);
    unsigned int start_h = h; // Para detectar ciclo (tabela cheia/não encontrado)

    while (tabelaHash[h] != NULL) {
        if (strcmp(tabelaHash[h]->drone.id, id) == 0) {
            return tabelaHash[h];
        }
        h = (h + 1) % HASH_SIZE; // Sondagem linear
        if (h == start_h) { // Tabela cheia ou ID não encontrado
            break;
        }
    }
    return NULL; // Drone não encontrado
}

// Insere novo drone na tabela hash, ou atualiza existente (O(1) esperado, O(N) pior caso)
DroneEntry *inserirOuAtualizarDrone(DroneInfo novo) {
    unsigned int h = hash(novo.id);
    unsigned int start_h = h;

    while (tabelaHash[h] != NULL) {
        if (strcmp(tabelaHash[h]->drone.id, novo.id) == 0) {
            // Atualiza informações do drone existente
            tabelaHash[h]->drone = novo;
            return tabelaHash[h];
        }
        h = (h + 1) % HASH_SIZE; // Sondagem linear
        if (h == start_h) { // Tabela cheia (improvável com HASH_SIZE grande)
            return NULL; // Erro: Tabela hash cheia ou problema de lógica
        }
    }

    // Não achou drone, cria novo e insere
    DroneEntry *novoEntry = (DroneEntry *)malloc(sizeof(DroneEntry));
    if (!novoEntry) {
        perror("Falha ao alocar DroneEntry");
        exit(EXIT_FAILURE);
    }
    novoEntry->drone = novo;
    novoEntry->historico = NULL; // Histórico começa vazio, a próxima função adiciona a primeira posição
    tabelaHash[h] = novoEntry;
    
    return novoEntry;
}

// Adiciona posição no histórico do drone (O(1))
void adicionarPosicaoHistorico(DroneEntry *entry, Posicao pos) {
    PosicaoNode *novoNo = (PosicaoNode *)malloc(sizeof(PosicaoNode));
    if (!novoNo) {
        perror("Falha ao alocar PosicaoNode");
        exit(EXIT_FAILURE);
    }
    novoNo->pos = pos;
    novoNo->prox = entry->historico; // Insere no início da lista
    entry->historico = novoNo;
}

// Atualiza drone com menor bateria (O(1))
void atualizarDroneMenorBateria(DroneEntry *entry) {
    if (droneMenorBateria == NULL || entry->drone.bateria < droneMenorBateria->drone.bateria) {
        droneMenorBateria = entry;
    }
}

// Funções da AVL
int altura(NodeAltitude *n) {
    return n ? n->altura : 0;
}

int max(int a, int b) {
    return (a > b) ? a : b;
}

NodeAltitude *rotacaoDireita(NodeAltitude *y) {
    NodeAltitude *x = y->left;
    y->left = x->right;
    x->right = y;
    y->altura = max(altura(y->left), altura(y->right)) + 1;
    x->altura = max(altura(x->left), altura(x->right)) + 1;
    return x;
}

NodeAltitude *rotacaoEsquerda(NodeAltitude *x) {
    NodeAltitude *y = x->right;
    x->right = y->left;
    y->left = x;
    x->altura = max(altura(x->left), altura(x->right)) + 1;
    y->altura = max(altura(y->left), altura(y->right)) + 1;
    return y;
}

int balanceamento(NodeAltitude *n) {
    return n ? altura(n->left) - altura(n->right) : 0;
}

// Insere um drone na árvore AVL (ordenado por altitude) - O(log n)
NodeAltitude *inserirAVL(NodeAltitude *raiz, DroneEntry *entry) {
    if (!raiz) {
        NodeAltitude *novo = (NodeAltitude *)malloc(sizeof(NodeAltitude));
        if (!novo) {
            perror("Falha ao alocar NodeAltitude");
            exit(EXIT_FAILURE);
        }
        novo->droneEntry = entry;
        novo->left = novo->right = NULL;
        novo->altura = 1;
        return novo;
    }

    if (entry->drone.posicao.z < raiz->droneEntry->drone.posicao.z) {
        raiz->left = inserirAVL(raiz->left, entry);
    } else if (entry->drone.posicao.z > raiz->droneEntry->drone.posicao.z) {
        raiz->right = inserirAVL(raiz->right, entry);
    } else {
        
        raiz->right = inserirAVL(raiz->right, entry);
    }

    raiz->altura = 1 + max(altura(raiz->left), altura(raiz->right));

    int bal = balanceamento(raiz);

    // Caso Left Left
    if (bal > 1 && entry->drone.posicao.z < raiz->left->droneEntry->drone.posicao.z)
        return rotacaoDireita(raiz);

    // Caso Right Right
    if (bal < -1 && entry->drone.posicao.z > raiz->right->droneEntry->drone.posicao.z)
        return rotacaoEsquerda(raiz);

    // Caso Left Right
    if (bal > 1 && entry->drone.posicao.z > raiz->left->droneEntry->drone.posicao.z) {
        raiz->left = rotacaoEsquerda(raiz->left);
        return rotacaoDireita(raiz);
    }

    // Caso Right Left
    if (bal < -1 && entry->drone.posicao.z < raiz->right->droneEntry->drone.posicao.z) {
        raiz->right = rotacaoDireita(raiz->right);
        return rotacaoEsquerda(raiz);
    }

    return raiz;
}

// Busca um drone na faixa de altitude [minZ, maxZ] (O(log n) no pior caso)
// Retorna o primeiro drone encontrado nessa faixa.
DroneEntry *buscarDronePorFaixaAVL(NodeAltitude *raiz, float minZ, float maxZ) {
    if (!raiz) return NULL;

    // Se a altitude do nó atual está na faixa, retorna ele
    if (raiz->droneEntry->drone.posicao.z >= minZ && raiz->droneEntry->drone.posicao.z <= maxZ) {
        return raiz->droneEntry;
    }

    // Se a altitude mínima da faixa é menor que a altitude do nó atual, verifica a subárvore esquerda
    if (minZ < raiz->droneEntry->drone.posicao.z) {
        DroneEntry *esq = buscarDronePorFaixaAVL(raiz->left, minZ, maxZ);
        if (esq) return esq;
    }

    // Se a altitude máxima da faixa é maior que a altitude do nó atual, verifica a subárvore direita
    if (maxZ > raiz->droneEntry->drone.posicao.z) {
        DroneEntry *dir = buscarDronePorFaixaAVL(raiz->right, minZ, maxZ);
        if (dir) return dir;
    }

    return NULL;
}

// Função para imprimir a rota de retorno do drone (O(x))
// Inicia no último ponto (mais recente) e vai até o x-ésimo ponto visitado.
void imprimirRotaRetorno(DroneEntry *entry, int x) {
    if (!entry || !entry->historico) {
        printf("Nenhuma posicao registrada para este drone ou drone nao encontrado.\n");
        return;
    }

    printf("Rota de retorno do drone %s (do último até o %d-ésimo ponto):\n", entry->drone.id, x);
    PosicaoNode *p = entry->historico;
    int count = 0;
    while (p != NULL && count < x) {
        printf("Ponto %d: (%.2f, %.2f, %.2f)\n", count + 1, p->pos.x, p->pos.y, p->pos.z);
        p = p->prox;
        count++;
    }
}

